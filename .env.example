# Copy to .env and fill in. .env is gitignored; this file is not.
# Deployed values live in SSM under /gtb/<dev|prod>/<snake_name> (scripts/put_secrets.py).
# The cTrader client id/secret and tokens are not here: every run (local ones too, with your AWS
# credentials) reads the account's shared pair in SSM /platform/shared/ctrader-*.

# cTrader account to trade (demo account for local runs; scripts/broker_smoke.py refuses live)
CTRADER_ACCOUNT_ID=
CTRADER_ACCOUNT_NUMBER=
CTRADER_ACCOUNT_NAME=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS region for boto3, scripts and local terraform (default eu-west-1)
AWS_REGION=eu-west-1
