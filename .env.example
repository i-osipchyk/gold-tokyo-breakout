# Copy to .env and fill in. .env is gitignored; this file is not.
# Deployed values live in SSM under /gtb/<dev|prod>/<snake_name> (scripts/put_secrets.py).

# cTrader Open API (demo account for local runs; scripts/broker_smoke.py refuses live)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ACCOUNT_NUMBER=
CTRADER_ACCOUNT_NAME=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS region for boto3, scripts and local terraform (default eu-west-1)
AWS_REGION=eu-west-1
